# Auth recovery
AUTH_RESET_TOKEN_MINUTES=30
AUTH_EXPOSE_RESET_TOKEN=false
AUTH_RESET_BASE_URL=http://localhost:5173/reset-password

# PayFast (defaults below are PayFast's published sandbox test-merchant
# credentials - fine for local/sandbox testing, MUST be replaced with the
# real Rock Mission Ministries merchant account before going live)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_NOTIFY_URL=http://localhost:8080/api/payfast/notify

# Printful (print-on-demand fulfillment) - disabled until a real account
# and product sync exist
PRINTFUL_ENABLED=false
PRINTFUL_API_KEY=
